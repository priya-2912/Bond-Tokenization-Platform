PORT=4000
NETWORK=sepolia
RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
# Wallet that holds COMPLIANCE_ROLE on KYCRegistry (test wallet only!)
COMPLIANCE_PRIVATE_KEY=0xYOUR_TEST_COMPLIANCE_KEY
# Shared secret the admin console sends in the x-admin-key header
ADMIN_API_KEY=change-me
# Allowed frontend origin
CORS_ORIGIN=http://localhost:5173
# Indexer
INDEXER_POLL_MS=8000
# Keep small: free RPC tiers often limit eth_getLogs ranges
INDEXER_BLOCK_RANGE=500
