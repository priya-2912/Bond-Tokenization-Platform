# Optional. Vite exposes VITE_* values to the browser, so NEVER put a secret here.
# Use a public RPC, or a key restricted to your site's domain in the provider dashboard.
VITE_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
VITE_LOCAL_RPC_URL=http://127.0.0.1:8545

# Optional KYC / events backend (see backend/). Defaults to http://localhost:4000
VITE_BACKEND_URL=http://localhost:4000
# DEV ONLY: this value is visible to anyone who opens the site's JavaScript.
# Leave empty in production and use signed-wallet admin auth on the backend instead.
VITE_ADMIN_API_KEY=
